# Copier en .env (jamais commité).
# Secrets internes, à générer: openssl rand -hex 32
WORKER_SECRET=
SECRETS_KEY=          # chiffre les clés API des utilisateurs: ne plus le changer une fois en service
# Modèle utilisé pour les évaluations (facturé sur la clé API de chaque utilisateur).
JOBRADAR_MODEL=claude-opus-5-5
# Recherches par utilisateur et par jour (ménage l'IP du serveur auprès des job boards).
SEARCHES_PER_DAY=10
# Adresse d'écoute de l'app (127.0.0.1 = local seulement, 0.0.0.0 = réseau local).
JOBRADAR_BIND=127.0.0.1
# Port exposé sur l'hôte (changer s'il est déjà pris).
JOBRADAR_PORT=8090
# Images à utiliser (par défaut celles publiées par ce dépôt).
# JOBRADAR_IMAGE=ghcr.io/lilyanlefevre/jobradar:latest
# JOBRADAR_WORKER_IMAGE=ghcr.io/lilyanlefevre/jobradar-worker:latest
# Profil optionnel "tunnel" (Cloudflare): COMPOSE_PROFILES=tunnel + jeton du tunnel.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARED_TOKEN=
