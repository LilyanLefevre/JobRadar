# Copier en .env (jamais commité).
# Secrets internes, à générer: openssl rand -hex 32
WORKER_SECRET=
# SECRETS_KEY chiffre les clés API des utilisateurs: ne plus le changer une fois en service.
SECRETS_KEY=
# Modèle Claude à utiliser à la place de celui de worker/providers.json (facultatif).
# JOBRADAR_MODEL=
# Recherches par utilisateur et par jour (ménage l'IP du serveur auprès des job boards).
SEARCHES_PER_DAY=10
# Inscription sur invitation: e-mails autorisés à créer un compte (séparés par des virgules). Vide = ouvert à tous.
# SIGNUP_ALLOWLIST=ami1@exemple.com,ami2@exemple.com
# Par défaut le dashboard PocketBase (/_/) est bloqué via le tunnel public: y accéder par le port local ou un tunnel SSH.
# ADMIN_PUBLIC=1 pour l'autoriser.
# Alertes quotidiennes : fuseau, heure du passage (format cron : minute heure * * *) et nombre d'alertes par utilisateur.
# TZ=Europe/Paris
# ALERTS_CRON=0 7 * * *
# ALERTS_PER_USER=3
# Notifications push : adresse de contact transmise aux services de push (mailto:vous@exemple.com ou https://...).
# VAPID_SUBJECT=mailto:vous@exemple.com
# Adresse d'écoute de l'app (127.0.0.1 = local seulement, 0.0.0.0 = réseau local).
JOBRADAR_BIND=127.0.0.1
# Port exposé sur l'hôte (changer s'il est déjà pris).
JOBRADAR_PORT=8090
# Images à utiliser (par défaut celles publiées par ce dépôt).
# JOBRADAR_IMAGE=ghcr.io/lilyanlefevre/jobradar:latest
# JOBRADAR_WORKER_IMAGE=ghcr.io/lilyanlefevre/jobradar-worker:latest
# Profil optionnel "tunnel" (Cloudflare): COMPOSE_PROFILES=tunnel + jeton du tunnel.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARED_TOKEN=
