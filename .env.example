# Copier en .env (jamais commité).
# Jeton d'authentification de la CLI claude, généré avec `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Modèle utilisé pour l'évaluation (alias claude).
JOBRADAR_MODEL=sonnet
# Adresse d'écoute sur l'hôte (127.0.0.1 = local seulement, 0.0.0.0 = réseau local).
JOBRADAR_BIND=127.0.0.1
# Image à utiliser (par défaut celle publiée par ce dépôt).
# JOBRADAR_IMAGE=ghcr.io/lilyanlefevre/jobradar:latest
# Seulement pour le profil "tunnel": jeton du tunnel Cloudflare.
# CLOUDFLARED_TOKEN=
